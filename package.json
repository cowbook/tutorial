{
    "name": "cowbook-tutorial",
    "version": "0.0.1",
    "description": "Bilingual programming tutorials built with Nextra",
    "private": true,
    "packageManager": "pnpm@10.34.6",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "dev": "next dev --webpack",
        "build": "next build --webpack && pagefind --site out --output-path out/_pagefind && node scripts/check-export.mjs",
        "typecheck": "next typegen && tsc --noEmit",
        "lint": "eslint .",
        "images:optimize": "node scripts/optimize-images.mjs",
        "test:export": "node scripts/check-export.mjs",
        "test:e2e": "playwright test",
        "start": "node scripts/serve-export.mjs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cowbook/tutorial.git"
    },
    "author": "Shu Ding <g@shud.in>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/cowbook/tutorial/issues"
    },
    "homepage": "https://www.xiaoniushu.com/",
    "dependencies": {
        "next": "16.3.8",
        "nextra": "4.6.1",
        "nextra-theme-docs": "4.6.1",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@next/eslint-plugin-next": "16.3.8",
        "@playwright/test": "1.63.0",
        "@tailwindcss/postcss": "4.3.3",
        "@types/node": "24.19.1",
        "@types/mdx": "2.0.14",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "eslint": "10.12.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.13.0",
        "pagefind": "1.5.2",
        "postcss": "8.5.29",
        "sharp": "0.35.5",
        "tailwindcss": "4.3.3",
        "typescript": "5.9.3",
        "typescript-eslint": "8.71.1"
    }
}
